rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
//
// Each signed-in user gets their own subtree at users/{their uid}/kv/... —
// this makes sure nobody can read or write anyone else's data, including
// via a stolen API key (Firebase's public web config is not a secret;
// these rules are what actually enforce privacy).

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/kv/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
